# ==============================================================================
# Mareb Events (منصة مأرب إيفنتس) - نموذج متغيرات البيئة
# ==============================================================================
# ملاحظة أمنية:
# هذا الملف كقالب توضيحي فقط ولا يحتوي على أي قيم حساسة أو كلمات مرور.
# للاستخدام المحلي، انسخ هذا الملف إلى .env.local وضع قيم مشروع Supabase الخاص بك.
# لوحة تحكم سوبابيز: Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# رابط مشروع Supabase (MarebEvents)
NEXT_PUBLIC_SUPABASE_URL=

# المفتاح العام (Publishable Key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
